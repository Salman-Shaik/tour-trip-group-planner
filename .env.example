# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public production origin, for example https://roamly.example.com
AUTH_URL=http://localhost:3000
# Set to true when deployed behind a trusted reverse proxy.
AUTH_TRUST_HOST=true
# Optional: on first startup only, import this JSON file instead of the empty template.
# With Docker Compose, place the file in ./imports and use /imports/<filename>.json.
ROAMLY_DB_IMPORT_PATH=
