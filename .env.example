# Generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public production origin, for example https://roamly.example.com
AUTH_URL=http://localhost:3000
# Set to true when deployed behind a trusted reverse proxy.
AUTH_TRUST_HOST=true
# Optional: on first startup only, import this JSON file instead of the empty template.
# With Docker Compose, place the file in ./imports and use /imports/<filename>.json.
ROAMLY_DB_IMPORT_PATH=
# json (default) or firestore. Firebase App Hosting and Cloud Run should use firestore.
ROAMLY_DB_BACKEND=json
# Optional Firestore project/namespace overrides. Google-hosted runtimes normally supply the project ID.
GOOGLE_CLOUD_PROJECT=
ROAMLY_FIRESTORE_COLLECTION=roamly_internal
# Optional browser Analytics configuration. These Firebase web identifiers are public.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
